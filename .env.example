# Copiez ce fichier en .env (ou renseignez ces variables chez votre hébergeur).
PORT=3000
NODE_ENV=production
APP_URL=https://votre-domaine.fr
DATA_DIR=./data

# Premier compte agence (créé au premier démarrage, mot de passe à changer à la connexion)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# E-mail (SMTP) — laisser vide pour simuler les envois
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CHR Intérim <no-reply@votre-domaine.fr>"

# SMS et WhatsApp (Twilio) — laisser vide pour simuler les envois
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
